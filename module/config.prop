# Y700 统一模块配置
# V7.1 起支持热重载: 改完保存, 最多 5 秒自动生效, 不用重启 (见 runtime.log 的"配置热重载"记录)
# 1=开启 0=关闭

ENABLE_THERMAL_BYPASS=1
ENABLE_CHARGE_LOG=1
SAMPLE_INTERVAL=5

# 伪装温度 (毫摄氏度, 28000=28C)
FAKE_TEMP_CHG=25000
FAKE_TEMP_BATT=28000
FAKE_TEMP_USB=25000
FAKE_TEMP_AP=30000

LOG_KEEP_COUNT=30

# 杀温控进程的间隔秒数 (越小杀得越勤, 但太勤会导致系统反复拉起进程; 默认60)
KILL_INTERVAL=60

# ==== 兼容性开关 (V7.0 新增, V7.1 起改完不用重启) ====
# 温区处理方式: 1=禁用温区+伪装温度 (默认, 性能释放最好)
#               2=仅伪装温度, 保持温区 mode=enabled
# 若充电被锁在 10W 左右, 改成 2 保存即可(5 秒内生效)
ZONE_MODE=1

# 是否周期击杀温控进程: 0=不杀 (默认, 交给平台自管)  1=杀
# 说明: V6.x 的「杀温控进程」因实现缺陷一直是静默失效(等于没杀), V7.0 才真正生效,
#       所以默认保持 0 以免升级后行为被悄悄改变; 需要更激进地压制温控可改 1
KILL_THERMAL=0
