# Y700 统一模块配置 (修改后重启生效)
# 1=开启 0=关闭

ENABLE_THERMAL_BYPASS=1
ENABLE_CHARGE_LOG=1
SAMPLE_INTERVAL=5

# 伪装温度 (毫摄氏度, 28000=28C)
FAKE_TEMP_CHG=25000
FAKE_TEMP_BATT=28000
FAKE_TEMP_USB=25000
FAKE_TEMP_AP=30000

LOG_KEEP_COUNT=30

# 杀温控进程的间隔秒数 (越小杀得越勤, 但太勤会导致系统反复拉起进程; 默认60)
KILL_INTERVAL=60

# ==== 兼容性开关 (V7.0 新增) ====
# 温区处理方式: 1=禁用温区+伪装温度 (默认, 性能释放最好)
#               2=仅伪装温度, 保持温区 mode=enabled
# 若充电被锁在 10W 左右, 尝试改为 2 并重启模块
ZONE_MODE=1

# 是否击杀温控进程: 1=杀 (默认)  0=不杀, 交给平台自管
# 若充电/发热策略异常, 尝试改为 0
KILL_THERMAL=1
